# Copy to .env, replace every CHANGE_ME value, then run `make up`.
APP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
WEB_CONCURRENCY=2

POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=jobplatform

# Generate independent random secrets of at least 32 bytes.
SECRET_KEY=CHANGE_ME_ACCESS_TOKEN_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PAGES=30
UPLOAD_MAX_ARCHIVE_ENTRIES=1000
UPLOAD_MAX_UNCOMPRESSED_BYTES=20971520
UPLOAD_MAX_TEXT_CHARS=100000
UPLOAD_PARSE_TIMEOUT_SECONDS=10
LEGAL_ENTITY_NAME=QLink local pilot operator
SUPPORT_EMAIL=support@example.invalid
PRIVACY_CONTACT_EMAIL=privacy@example.invalid
INCIDENT_CONTACT_EMAIL=incident@example.invalid
FIDELITY_PROOF_SECRET_KEY=CHANGE_ME_PROOF_SECRET_AT_LEAST_32_BYTES
EMPLOYER_INVITE_CODE=CHANGE_ME_EMPLOYER_INVITE_CODE

# false: start in visible rules_only mode if the key is absent.
# true: make provider availability a readiness gate for an AI-enabled pilot.
MODEL_REQUIRED=false

# PR10 Model Gateway. Business code must not hardcode offline model IDs.
AI_ENABLED=true
AI_PRIMARY_PROVIDER=openai_compatible
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_DATA_REGION=cn-beijing
AI_MODEL_DEFAULT=qwen-plus
AI_MODEL_RESUME_PARSE=
AI_MODEL_INTERVIEW=
AI_MODEL_REWRITE=
AI_MODEL_REASONING=
AI_MODEL_EMBEDDING=
AI_MODEL_RERANK=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
AI_AUDIT_CONTENT_LOGGING=false

# Private Evidence Vault storage. Production should use a private object-store
# adapter; Compose persists the local pilot volume at /data/evidence-vault.
EVIDENCE_VAULT_DIR=/data/evidence-vault
# local (default) | s3 | minio
OBJECT_STORAGE_BACKEND=local
SIGNED_URL_TTL_SECONDS=300
# Prefer a dedicated signing key; falls back to FIDELITY_PROOF_SECRET_KEY / SECRET_KEY.
EVIDENCE_DOWNLOAD_SIGNING_KEY=
# Optional S3/MinIO (when OBJECT_STORAGE_BACKEND=s3|minio)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Virus scan: EICAR signature always on when enabled; optional ClamAV daemon.
VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_FAIL_MODE=closed
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# Transitional DeepSeek mapping (optional). Leave blank for rules_only.
# Do NOT set DEEPSEEK_MODEL to an offline model ID; leave empty or set a live ID.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
# Greenhouse GET Job Board API 为企业公开招聘数据；格式 board_token:展示名。
GREENHOUSE_BOARDS=anthropic:Anthropic,stripe:Stripe,discord:Discord
GREENHOUSE_MAX_JOBS_PER_BOARD=200
# Shared platform guard for free interview provider calls (all users combined).
INTERVIEW_GLOBAL_PROVIDER_CALLS_PER_DAY=5000

# Admin-only actual-cost ledger; values are CNY per million tokens.
DEEPSEEK_INPUT_PRICE_CNY_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_CNY_PER_MILLION=
DEEPSEEK_CACHE_HIT_PRICE_CNY_PER_MILLION=
DEEPSEEK_CACHE_MISS_PRICE_CNY_PER_MILLION=
DEEPSEEK_PRICE_VERSION=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_START_TLS=true
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_LIMIT=3
PASSWORD_RESET_WINDOW_SECONDS=3600
