# Copy to .env, replace every CHANGE_ME value, then run `make up`.
APP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
WEB_CONCURRENCY=2

POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=jobplatform

# Generate independent random secrets of at least 32 bytes.
SECRET_KEY=CHANGE_ME_ACCESS_TOKEN_SECRET_AT_LEAST_32_BYTES
FIDELITY_PROOF_SECRET_KEY=CHANGE_ME_PROOF_SECRET_AT_LEAST_32_BYTES
EMPLOYER_INVITE_CODE=CHANGE_ME_EMPLOYER_INVITE_CODE

# false: start in visible rules_only mode if the key is absent.
# true: make provider availability a readiness gate for an AI-enabled pilot.
MODEL_REQUIRED=false
# Leave blank for rules_only acceptance. Set a real provider key only when
# MODEL_REQUIRED=true and AI-backed flows are part of the acceptance scope.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Shared platform guard for free interview provider calls (all users combined).
INTERVIEW_GLOBAL_PROVIDER_CALLS_PER_DAY=5000

# Admin-only actual-cost ledger; values are CNY per million tokens.
DEEPSEEK_INPUT_PRICE_CNY_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_CNY_PER_MILLION=
DEEPSEEK_CACHE_HIT_PRICE_CNY_PER_MILLION=
DEEPSEEK_CACHE_MISS_PRICE_CNY_PER_MILLION=
DEEPSEEK_PRICE_VERSION=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
