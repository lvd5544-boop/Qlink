# Copy outside Git or to .env.production, replace every placeholder, then:
# chmod 600 .env.production
# make production-preflight PRODUCTION_ENV_FILE=.env.production

PUBLIC_DOMAIN=jobs.example.com
PUBLIC_ORIGIN=https://jobs.example.com
ACME_EMAIL=operator@example.com
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
WEB_CONCURRENCY=2
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_SECRET_AT_LEAST_24_CHARS
POSTGRES_DB=jobplatform
SECRET_KEY=CHANGE_ME_INDEPENDENT_ACCESS_SECRET_AT_LEAST_32_CHARS
FIDELITY_PROOF_SECRET_KEY=CHANGE_ME_INDEPENDENT_PROOF_SECRET_AT_LEAST_32_CHARS
EVIDENCE_DOWNLOAD_SIGNING_KEY=CHANGE_ME_INDEPENDENT_DOWNLOAD_SECRET_AT_LEAST_32_CHARS
EMPLOYER_INVITE_CODE=CHANGE_ME_RANDOM_EMPLOYER_INVITE_AT_LEAST_16_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

MODEL_REQUIRED=false
AI_ENABLED=false
AI_PRIMARY_PROVIDER=openai_compatible
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_DATA_REGION=cn-beijing
AI_MODEL_DEFAULT=qwen-plus
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1
AI_AUDIT_CONTENT_LOGGING=false

OBJECT_STORAGE_BACKEND=local
SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

VIRUS_SCAN_ENABLED=true
VIRUS_SCAN_FAIL_MODE=closed
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# The Nginx edge accepts up to 6 MiB including multipart overhead. Keep the
# application file limit at or below 5 MiB unless both layers are reviewed.
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PAGES=30
UPLOAD_MAX_ARCHIVE_ENTRIES=1000
UPLOAD_MAX_UNCOMPRESSED_BYTES=20971520
UPLOAD_MAX_TEXT_CHARS=100000
UPLOAD_PARSE_TIMEOUT_SECONDS=10

INTERVIEW_GLOBAL_PROVIDER_CALLS_PER_DAY=5000
PILOT_CONSENT_VERSION=pilot-v1

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_START_TLS=true
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_LIMIT=3
PASSWORD_RESET_WINDOW_SECONDS=3600

# Replace with the accountable operator/company and monitored inboxes shown
# on the public legal pages. Placeholder/example addresses fail preflight.
LEGAL_ENTITY_NAME=CHANGE_ME_LEGAL_OPERATOR
SUPPORT_EMAIL=support@example.com
PRIVACY_CONTACT_EMAIL=privacy@example.com
INCIDENT_CONTACT_EMAIL=incident@example.com

# Change each flag to true only after the named external control has actually
# been verified. `make production-go-live-preflight` fails while any is false.
OFFSITE_BACKUP_CONFIRMED=false
RESTORE_REHEARSAL_CONFIRMED=false
MONITORING_ALERTS_CONFIRMED=false
LEGAL_REVIEW_CONFIRMED=false
